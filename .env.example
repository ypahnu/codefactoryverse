# Flask
SECRET_KEY=change-me-to-random
DATABASE_URL=sqlite:///codefactory.db

# LLM generic
MODEL_API_KEY=LLM_...

# Modal.com - For Path A direct inference (everything in codefactoryverse, no modal_app.py)
MODAL_WORKSPACE_ID=ac-...
MODAL_TOKEN_ID=ak-...
MODAL_TOKEN_SECRET=as-...
MODAL_ENV=codefactory-platform

# Modal Proxy tokens for inference Endpoints (LLM as service)
# Create at https://modal.com/settings/proxy-tokens or modal workspace proxy-tokens create
MODAL_KEY=wk-...
MODAL_SECRETE=ws-...
# Combined bearer = wk-....ws-... (used as api_key)

# Endpoint hostname from https://modal.com/endpoints -> Create Endpoint
# Example: my-endpoint.us-west.modal.direct or qwen-Qwen3-8B--xxx.modal.run
MODAL_ENDPOINT_HOST=...

# Voice - Meta Muse STT + Cartesia TTS (both keys in .env per user request)
CARTESIA_API_KEY=sk_car_...
# MODEL_API_KEY already used for Meta Muse STT (muse-voice-transcribe-1.0)

